{
  "name": "pulseforge",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, GPU-accelerated audio visualizer and music-video renderer",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning setup/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "spike:determinism": "node --disable-warning=ExperimentalWarning spike/determinism.ts",
    "spike:export": "node --disable-warning=ExperimentalWarning spike/export.ts",
    "validate": "node --disable-warning=ExperimentalWarning spike/validate.ts",
    "golden": "node --disable-warning=ExperimentalWarning spike/golden.ts",
    "render": "node --disable-warning=ExperimentalWarning src/cli/render.ts",
    "dev": "node --disable-warning=ExperimentalWarning scripts/app.ts --dev",
    "build": "node --disable-warning=ExperimentalWarning scripts/app.ts",
    "modules:check": "node --disable-warning=ExperimentalWarning scripts/check-modules.ts",
    "presets:builtin": "node --disable-warning=ExperimentalWarning scripts/make-builtin-presets.ts",
    "contact-sheet": "node --disable-warning=ExperimentalWarning scripts/contact-sheet.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "main": "dist/app/main.js",
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.0",
    "zustand": "^5.0.15"
  }
}

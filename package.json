{
  "name": "pulseforge",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted, GPU-accelerated audio visualizer and music-video renderer",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning setup/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=out/vitest-last.json",
    "check": "npm run typecheck && npm run lint && npm run test",
    "spike:determinism": "node --disable-warning=ExperimentalWarning spike/determinism.ts",
    "spike:export": "node --disable-warning=ExperimentalWarning spike/export.ts",
    "validate": "node --disable-warning=ExperimentalWarning spike/validate.ts",
    "golden": "node --disable-warning=ExperimentalWarning spike/golden.ts",
    "render": "node --disable-warning=ExperimentalWarning src/cli/render.ts",
    "batch": "node --disable-warning=ExperimentalWarning src/cli/batch.ts",
    "dev": "node --disable-warning=ExperimentalWarning scripts/app.ts --dev",
    "build": "node --disable-warning=ExperimentalWarning scripts/app.ts",
    "modules:check": "node --disable-warning=ExperimentalWarning scripts/check-modules.ts",
    "milkdrop:measure": "node --disable-warning=ExperimentalWarning scripts/measure-milkdrop.ts",
    "contact-sheet": "node --disable-warning=ExperimentalWarning scripts/contact-sheet.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "main": "dist/app/main.js",
  "dependencies": {
    "butterchurn": "2.6.7",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "app.pulseforge.studio",
    "productName": "Pulseforge",
    "copyright": "MIT licence",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/app/**/*",
      "!dist/app/**/*.map",
      "setup/**/*",
      "python/**/*",
      "!**/__pycache__/**",
      "templates/**/*",
      "modules/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Pulseforge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Pulseforge"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.video",
      "minimumSystemVersion": "14.0",
      "artifactName": "Pulseforge-${version}-mac-arm64.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Pulseforge ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "pvproj",
        "name": "Pulseforge project",
        "description": "Pulseforge project",
        "role": "Editor"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  }
}

# Top-level Python requirements for the ML sidecar (P0: stem separation only).
#
# This is the input. The pinned, hashed resolution lives in requirements.lock.txt,
# generated by `npm run setup -- --relock` and committed. Setup installs only from
# the lock, only from the local wheelhouse, only with hashes.
#
# torch is pinned to an exact CUDA build: the local version tag stops the resolver
# from ever settling on the CPU-only wheel from PyPI.

torch==2.13.0+cu130
demucs==4.1.0

# demucs 4.1.0 imports numpy everywhere, but its metadata only declares numpy for
# darwin/x86_64, so on Windows it would never be installed. Listed explicitly; the
# resolver picks the newest numpy with a Python 3.11 wheel.
numpy

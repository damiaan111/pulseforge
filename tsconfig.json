{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is needed for WebGL2 types in the engine. The engine boundary (no document,
    // window, timers, wall clock…) is enforced by eslint.config.js, not by lib.
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // Sources run directly under Node's type stripping (setup/) and through a bundler
    // later (src/), so only erasable syntax and explicit .ts import extensions.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "setup", "spike", "scripts", "tests", "vitest.config.ts"]
}

{
  "formatVersion": 1,
  "id": "tpl.minimal.mono",
  "name": "Minimal Mono",
  "description": "One circular waveform in one colour, and nothing else. The restraint option — ambient, piano, acoustic.",
  "author": "Pulseforge",
  "version": 1,
  "affinity": {
    "prefer": { "energy": [0, 0.45], "density": [0, 0.45], "organic": [0.4, 1] },
    "tolerate": { "dynamics": "any" },
    "avoid": { "energy": [0.8, 1] },
    "weight": 0.95
  },
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "palette": {
    "strategy": "generate-from-style",
    "harmony": "mono",
    "baseHue": { "from": "darkness", "range": [210, 240] },
    "saturation": [0.05, 0.25],
    "background": [0.02, 0.06],
    "minTextContrast": 4.5
  },
  "slots": [
    {
      "id": "BACKDROP", "role": "BACKDROP", "required": true, "name": "Ground",
      "candidates": [
        { "module": "core.source.background", "weight": 1, "label": "Ground", "params": { "mode": "solid", "colorA": "@background" } }
      ]
    },
    {
      "id": "HERO", "role": "HERO", "required": true,
      "candidates": [
        { "module": "core.visualizer.radial", "weight": 3, "label": "Ring",
          "params": { "fill": "@text", "barCount": 180, "radius": 0.24, "length": 0.06, "thickness": 0.3, "mirror": true, "innerGlow": 0 } },
        { "module": "core.visualizer.orb", "weight": 2, "label": "Breath",
          "params": { "fill": "@text", "drive": "rms", "radius": 0.14, "swell": 0.2, "softness": 0.85, "ripple": 0.45, "ripples": 4, "core": 0.7 } }
      ]
    },
    {
      "id": "TEXT", "role": "TEXT", "condition": "hasTitle",
      "candidates": [
        { "module": "core.text.title", "weight": 1,
          "params": { "text": "$title", "color": "@text", "case": "lower", "size": 0.045, "letterSpacing": 0.3, "shadow": 0 } }
      ],
      "transform": { "y": 0.86 }
    },
    {
      "id": "LYRICS", "role": "LYRICS", "condition": "hasLyrics",
      "params": { "upcoming": "@secondary", "active": "@text", "sung": "@text", "shadowColor": "@textShadow" },
      "transform": { "y": 0.84 },
      "aspectOverrides": { "9:16": { "transform": { "y": 0.74 } } }
    },
    {
      "id": "LOGO", "role": "LOGO", "condition": "hasLogo",
      "candidates": [ { "module": "core.source.logo", "weight": 1, "params": { "image": "$logo", "size": 0.07, "opacity": 0.6, "tint": "@text", "tintAmount": 1 } } ],
      "transform": { "x": 0.5, "y": 0.08 },
      "aspectOverrides": { "9:16": { "transform": { "y": 0.14 } } }
    },
    {
      "id": "POST", "role": "POST", "required": true,
      "effects": [
        { "key": "grain", "module": "core.effect.grain", "params": { "amount": 0.025, "colour": 0 }, "probability": 0.3 }
      ]
    }
  ],
  "modulations": [
    { "label": "Level", "target": ["HERO.params.length", "HERO.params.swell"],
      "source": { "type": "rms", "stem": "mix" }, "mode": "add", "intensity": "medium", "response": "slow" },
    { "label": "Turn", "target": ["HERO.params.rotation"],
      "source": { "type": "noise", "stem": "mix" }, "mode": "add", "intensity": "subtle", "response": "slow" },
    { "label": "Ripple", "target": ["HERO.params.ripple"],
      "source": { "type": "band", "stem": "mix", "band": "lowMid" }, "mode": "add", "intensity": "subtle", "response": "smooth" }
  ],
  "arrangement": {
    "sections": {
      "intro": { "intensity": 0.45 },
      "build": { "intensity": 0.65 },
      "main": { "intensity": 0.9 },
      "breakdown": { "intensity": 0.5 },
      "outro": { "intensity": 0.4 }
    },
    "intensityTargets": ["HERO.params.length", "HERO.params.swell"],
    "floor": 0.55,
    "textHold": "untilFirstVocal",
    "fadeIn": 2,
    "fadeOut": 4
  },
  "variation": {
    "rerollable": ["slots.HERO.candidate", "palette.baseHue"],
    "locked": ["arrangement", "modulations"],
    "hueJitter": 30,
    "intensityJitter": 0.06
  },
  "budget": { "maxLayers": 5, "maxCost": 6 }
}

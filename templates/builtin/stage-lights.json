{
  "formatVersion": 1,
  "id": "tpl.stage.lights",
  "name": "Stage Lights",
  "description": "Beams from above, soft lights in the dark and a spectrum along the floor: the feel of a live show. Pop, rock, anything with a band.",
  "author": "Pulseforge",
  "version": 1,
  "affinity": {
    "prefer": { "energy": [0.45, 1], "organic": [0.3, 1], "density": [0.35, 1] },
    "tolerate": { "tempo": "any", "vocalWeight": "any" },
    "avoid": { "energy": [0, 0.25] },
    "weight": 0.95
  },
  "aspects": ["16:9", "9:16", "1:1", "4:5"],
  "palette": {
    "strategy": "generate-from-style",
    "harmony": "complementary",
    "baseHue": { "from": "key", "range": [0, 360] },
    "saturation": [0.7, 1],
    "background": [0.02, 0.06],
    "minTextContrast": 4.5
  },
  "slots": [
    {
      "id": "BACKDROP", "role": "BACKDROP", "required": true, "name": "Dark hall",
      "candidates": [
        { "module": "core.source.background", "weight": 3, "label": "Dark hall",
          "params": { "mode": "gradient", "gradient": "radial", "colorA": "@background", "colorB": "#000000", "drift": 0.2 } },
        { "module": "core.source.background", "weight": 2, "label": "Image", "needs": "hasBackgroundImage",
          "params": { "mode": "image", "image": "$backgroundImage", "dim": 0.65, "zoom": 1.08, "drift": 0.3 } }
      ]
    },
    {
      "id": "CROWD", "role": "ACCENT", "name": "Lights", "probability": 0.85, "priority": 40, "opacity": 0.8, "blend": "screen",
      "candidates": [
        { "module": "core.visualizer.bokeh", "weight": 1, "label": "Lights",
          "params": { "colorA": "@primary", "colorB": "@secondary", "colorC": "@accent", "brightness": 0.7, "density": 0.45, "size": 1.1, "rim": 0.5, "react": 0.8 } }
      ]
    },
    {
      "id": "HERO", "role": "HERO", "required": true, "name": "Beams", "blend": "screen",
      "candidates": [
        { "module": "core.visualizer.rays", "weight": 3, "label": "From above",
          "params": { "colorA": "@accent", "colorB": "@primary", "brightness": 0.9, "x": 0.5, "y": -0.08, "beams": 11, "reach": 1.5, "core": 0.1, "react": 0.9 } },
        { "module": "core.visualizer.rays", "weight": 2, "label": "Backlight",
          "params": { "colorA": "@accent", "colorB": "@primary", "brightness": 0.85, "x": 0.5, "y": 0.52, "beams": 14, "reach": 1.1, "core": 0.14, "react": 0.9 } },
        { "module": "core.visualizer.rays", "weight": 1, "label": "Side light",
          "params": { "colorA": "@accent", "colorB": "@secondary", "brightness": 0.9, "x": 0.08, "y": 0.05, "beams": 9, "reach": 1.9, "core": 0.08, "react": 0.9 } }
      ]
    },
    {
      "id": "FLOOR", "role": "ACCENT", "name": "Spectrum", "required": true, "priority": 60, "opacity": 0.9,
      "candidates": [
        { "module": "core.visualizer.bars", "weight": 3, "label": "Bars",
          "params": { "fill": "@secondary", "barCount": 96, "baseline": 0.97, "maxHeight": 0.22, "barWidth": 0.55 } },
        { "module": "core.visualizer.curve", "weight": 1, "label": "Line",
          "params": { "fill": "@secondary", "thickness": 0.004, "baseline": 0.95, "height": 0.14, "spread": 0.9, "fillBody": 0.25 } }
      ]
    },
    {
      "id": "TEXT", "role": "TEXT", "condition": "hasTitle",
      "candidates": [
        { "module": "core.text.title", "weight": 1,
          "params": { "text": "$title", "color": "@text", "case": "upper", "size": 0.085, "letterSpacing": 0.1, "glow": 0.5, "glowColor": "@glow", "shadow": 0.8, "shadowColor": "@textShadow" } }
      ],
      "transform": { "y": 0.46 }
    },
    {
      "id": "LYRICS", "role": "LYRICS", "condition": "hasLyrics",
      "params": { "size": 0.06, "maxWidth": 0.9, "upcoming": "@text", "active": "@accent", "sung": "@secondary", "shadow": 0.9, "glowColor": "@glow", "shadowColor": "@textShadow" },
      "transform": { "y": 0.62 },
      "aspectOverrides": { "9:16": { "transform": { "y": 0.6 } } }
    },
    {
      "id": "LOGO", "role": "LOGO", "condition": "hasLogo",
      "candidates": [ { "module": "core.source.logo", "weight": 1, "params": { "image": "$logo", "size": 0.1, "opacity": 0.9 } } ],
      "transform": { "x": 0.92, "y": 0.1 },
      "aspectOverrides": { "9:16": { "transform": { "x": 0.85, "y": 0.14 } } }
    },
    {
      "id": "POST", "role": "POST", "required": true,
      "effects": [
        { "key": "bloom", "module": "core.effect.bloom", "params": { "intensity": 0.8, "threshold": 0.6, "radius": 0.035 } },
        { "key": "chromatic", "module": "core.effect.chromatic", "params": { "amount": 0.0015 }, "probability": 0.5 },
        { "key": "vignette", "module": "core.effect.vignette", "params": { "amount": 0.5 } },
        { "key": "grain", "module": "core.effect.grain", "params": { "amount": 0.045 }, "probability": 0.6 }
      ]
    }
  ],
  "modulations": [
    { "label": "Kick", "target": ["HERO.params.brightness", "HERO.params.reach"],
      "source": { "type": "onset", "stem": "drums" }, "mode": "add", "intensity": "medium", "response": "snappy" },
    { "label": "Crowd", "target": ["CROWD.params.brightness"],
      "source": { "type": "band", "stem": "mix", "band": "presence" }, "mode": "add", "intensity": "medium", "response": "smooth" },
    { "label": "Floor", "target": ["FLOOR.params.maxHeight", "FLOOR.params.height"],
      "source": { "type": "rms", "stem": "bass" }, "mode": "add", "intensity": "subtle", "response": "smooth" },
    { "label": "Glow", "target": ["POST.bloom.intensity"],
      "source": { "type": "rms", "stem": "mix" }, "mode": "multiply", "intensity": "medium", "response": "smooth" },
    { "label": "Hit", "target": ["POST.chromatic.amount"],
      "source": { "type": "onset", "stem": "drums" }, "mode": "add", "intensity": "subtle", "response": "snappy" }
  ],
  "arrangement": {
    "sections": {
      "intro": { "intensity": 0.4, "removeLayers": ["CROWD"] },
      "build": { "intensity": 0.7, "addLayers": ["CROWD"] },
      "main": { "intensity": 1, "addLayers": ["CROWD"], "paletteShift": "accent" },
      "breakdown": { "intensity": 0.45 },
      "outro": { "intensity": 0.35, "removeLayers": ["CROWD"] }
    },
    "intensityTargets": ["HERO.params.brightness", "POST.bloom.intensity"],
    "floor": 0.4,
    "optionalLayers": ["CROWD"],
    "textHold": "untilFirstVocal",
    "drop": { "targets": ["HERO.params.brightness", "POST.bloom.intensity"], "amount": 0.5, "decaySeconds": 0.6 },
    "fadeIn": 1,
    "fadeOut": 3
  },
  "variation": {
    "rerollable": ["slots.HERO.candidate", "slots.FLOOR.candidate", "slots.CROWD.presence", "palette.baseHue"],
    "locked": ["arrangement"],
    "hueJitter": 40,
    "intensityJitter": 0.12
  },
  "budget": { "maxLayers": 8, "maxCost": 12 }
}

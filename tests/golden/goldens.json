        { "aspect": "16:9", "width": 640, "height": 360 },
        { "aspect": "9:16", "width": 360, "height": 640 },
        { "aspect": "1:1", "width": 480, "height": 480 }
      ],
      "frames": [0, 45, 90]
    },
    {
